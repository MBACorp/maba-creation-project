{
  "tests": [
    {
      "name": "Список релизов",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "expectedBody": {"releases": []},
      "bodyMatcher": "partial"
    },
    {
      "name": "Проверка обновления без версий",
      "method": "GET",
      "path": "/?action=check&platform=windows&version=1.0.0",
      "expectedStatus": 200,
      "expectedBody": {"available": false},
      "bodyMatcher": "partial"
    },
    {
      "name": "Неизвестная платформа отклоняется",
      "method": "GET",
      "path": "/?action=check&platform=linux&version=1.0.0",
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Загрузка без пароля запрещена",
      "method": "POST",
      "path": "/",
      "body": {"version": "1.0.0", "platform": "windows"},
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}
